# Build outputs
*.exe
*.o
*.obj
*.out
*.elf
*.hex
*.bin
*.map
*.list
*.su
*.cyclo
*.d
*.a

# Desktop C++ executable names
main
main.exe

# C/C++ build folders
Debug/
Release/
build/
cmake-build-*/

# STM32CubeIDE generated build folders
*/Debug/
*/Release/

# STM32CubeIDE local/project metadata
.metadata/
RemoteSystemsTempFiles/

# IDE/editor local settings
.vscode/
.idea/
*.code-workspace

# Temporary and backup files
*.tmp
*.bak
*.swp
*.orig
*.save
*.old

# Runtime/raw logs that should not bloat the repo
*.log
*.trace
*.dump

# OS files
.DS_Store
Thumbs.db

# Private learning/interview-prep notes
notes/
interview_prep/
inteview_prep/

# Large/raw media should be linked from README, not committed directly
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Keep project data files
!data/*.csv
!data/*.txt

# Keep documentation
!docs/*.md

# Keep lightweight README/demo images
!media/*.png
!media/*.jpg
!media/*.jpeg
!media/*.gif
